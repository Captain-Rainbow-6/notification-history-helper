<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.History.ActionRow" parent="">
        <!-- Share only visual state: both children keep independent click/focus targets. -->
        <item name="android:addStatesFromChildren">true</item>
        <item name="android:foreground">@drawable/action_feedback</item>
    </style>
    <style name="Widget.History.Action" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">100dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconSize">40dp</item>
        <item name="iconPadding">16dp</item>
        <item name="iconGravity">start</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>
    <style name="Widget.History.Help" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="srcCompat">@drawable/ic_help_outline</item>
    </style>
    <style name="Widget.History.Language" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
