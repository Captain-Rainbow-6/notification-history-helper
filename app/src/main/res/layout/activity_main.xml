<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">
            <TextView
                android:id="@+id/headlineText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/headline"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:accessibilityHeading="true" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                app:srcCompat="@drawable/ic_settings"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Notices consume the flexible space above, never a row below the actions.
             When space is limited, the outer ScrollView keeps all content reachable. -->
        <LinearLayout
            android:id="@+id/shortcutFeedbackGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="100dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/notice_card"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="20dp"
                android:paddingEnd="8dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textColor="@color/text_secondary"
                    android:textColorLink="@color/primary"
                    android:textSize="16sp"
                    android:accessibilityLiveRegion="polite" />
                <TextView
                    android:id="@+id/shortcutStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textColor="@color/text_secondary"
                    android:textColorLink="@color/primary"
                    android:textSize="16sp"
                    android:accessibilityLiveRegion="polite" />
                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textColor="@color/text_secondary"
                    android:textColorLink="@color/primary"
                    android:textSize="16sp"
                    android:accessibilityLiveRegion="assertive" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/closeShortcutMessageButton"
                style="@style/Widget.History.Help"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                app:srcCompat="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionsGroup"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/blueActionRow"
                style="@style/Widget.History.ActionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/action_blue">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openHistoryButton"
                    style="@style/Widget.History.Action"
                    android:text="@string/open_history"
                    android:textColor="@color/blue_content"
                    app:icon="@drawable/ic_history"
                    app:iconTint="@color/blue_content" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/historyHelpButton"
                    style="@style/Widget.History.Help"
                    android:contentDescription="@string/history_help_label"
                    app:tint="@color/blue_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/yellowActionRow"
                style="@style/Widget.History.ActionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/action_yellow">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addShortcutButton"
                    style="@style/Widget.History.Action"
                    android:text="@string/add_shortcut"
                    android:textColor="@color/yellow_content"
                    app:icon="@drawable/ic_add_home"
                    app:iconTint="@color/yellow_content" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/shortcutHelpButton"
                    style="@style/Widget.History.Help"
                    android:contentDescription="@string/shortcut_help_label"
                    app:tint="@color/yellow_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orangeActionRow"
                style="@style/Widget.History.ActionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/action_orange">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/appSettingsButton"
                    style="@style/Widget.History.Action"
                    android:text="@string/open_app_settings"
                    android:textColor="@color/orange_content"
                    app:icon="@drawable/ic_tune"
                    app:iconTint="@color/orange_content" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/permissionHelpButton"
                    style="@style/Widget.History.Help"
                    android:contentDescription="@string/permission_help_label"
                    app:tint="@color/orange_content" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/aboutButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="0dp"
                android:paddingEnd="40dp"
                android:gravity="start|center_vertical"
                android:text="@string/about"
                android:textSize="17sp"
                android:textColor="@color/text_secondary"
                app:icon="@drawable/ic_info"
                app:iconTint="@color/text_secondary"
                app:iconSize="28dp"
                app:iconPadding="14dp"
                app:iconGravity="start" />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
